# AM Express Trading — environment variables
#
# Copy to .env.local for development. NEVER commit a filled-in copy.
# In Vercel, set these per environment (Development / Preview / Production).

# ---------------------------------------------------------------------------
# Supabase — safe to expose to the browser
# ---------------------------------------------------------------------------
# The anon key is protected by Row Level Security. It is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# The service role key bypasses RLS entirely. It is read only in code that runs
# on the server (src/infrastructure/supabase/client/admin-client.ts, which
# throws if it is ever evaluated in a browser bundle).
# Used only for administrative operations: creating staff auth users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of the deployment, used for absolute URLs (receipt sharing).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Integration tests only (never set in production)
# ---------------------------------------------------------------------------
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_CASHIER_EMAIL=
# TEST_CASHIER_PASSWORD=

# ---------------------------------------------------------------------------
# Branding shown before sign-in
# ---------------------------------------------------------------------------
# Business settings live in the database behind Row Level Security, so they are
# unreadable until someone signs in. These three strings are needed before that
# — the sign-in heading, the browser tab title, and the installed app's name —
# so they are configured here instead. Optional; the defaults are AM Express
# Trading's.
# NEXT_PUBLIC_BUSINESS_NAME=AM Express Trading
# NEXT_PUBLIC_BUSINESS_SHORT_NAME=AM Express
# NEXT_PUBLIC_BUSINESS_DESCRIPTION=Inventory, point of sale, expenses and reporting.
